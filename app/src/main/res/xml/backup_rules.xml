<?xml version="1.0" encoding="utf-8"?>
<!--
   Legacy (API < 31) Auto Backup rules.

   NOTHING in this app may leave the device. allowBackup="false" already disables this, but the excludes are
   explicit so the intent survives anyone flipping that flag back. What is at stake here:
   proposals.hex — a complete SIGNED settlement transaction that moves the pot, held before the
         counterparty co-signs — plus openly_identity, a pinned pubkey/address minted once and reused forever.
         A restore both exfiltrates spend-authorising material and re-plants an unsignable identity
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
